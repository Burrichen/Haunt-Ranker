{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Haunt Ranker",
  "version": "../package.json",
  "identifier": "com.hauntranker.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Haunt Ranker",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/media/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Haunt Ranker",
    "copyright": "Copyright © 2026 Haunt Ranker. Not affiliated with, endorsed by, or sponsored by Universal Studios.",
    "category": "Entertainment",
    "shortDescription": "Browse, review and rank Halloween Horror Nights attractions.",
    "longDescription": "A local-first archive of Halloween Horror Nights houses, scare zones and event years, with personal ratings, notes and rankings. Everything is stored on this machine — there is no account and no server.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}
